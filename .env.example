# Medical Inventory System - Environment Template
# Copy this file to .env and fill in your actual credentials.

PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/medical_inventory

# JWT Security
JWT_SECRET=your_strong_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=ap.code.in@gmail.com
BREVO_SENDER_NAME=Upasana Medical Inventory

# Gemini Vision AI
GEMINI_API_KEY=your_gemini_api_key_here
