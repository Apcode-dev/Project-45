# Medical Inventory System - Android Release Signing Configuration Example
# Copy this template to "keystore.properties" in frontend/android/ and set your private parameters.
# DO NOT COMMIT "keystore.properties" OR "*.keystore" / "*.jks" TO GIT!

storeFile=release.keystore
storePassword=YOUR_KEYSTORE_STORE_PASSWORD
keyAlias=medical_inventory_key
keyPassword=YOUR_KEYSTORE_KEY_PASSWORD
